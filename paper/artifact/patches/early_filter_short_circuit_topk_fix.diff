+class _RevStr:
+    """Wraps a string so heap ordering treats larger strings as "smaller".
+
+    Used as the heap tie-breaker: at equal score the candidate with the
+    lexicographically larger doc_id compares as the minimum and is evicted
+    first, preserving the ascending-doc_id tie-break of the public contract.
+    """
+
+    __slots__ = ("value",)
+
+    def __init__(self, value: str) -> None:
+        self.value = value
+
+    def __lt__(self, other: "_RevStr") -> bool:
+        return self.value > other.value
+
+    def __eq__(self, other: object) -> bool:
+        return isinstance(other, _RevStr) and self.value == other.value

 from __future__ import annotations

+from functools import lru_cache
+
 from score_recompute.risk_model import score_profile


+# Memoize the pure risk model: since ``score_profile`` is a pure function of the
+# profile key, cache its result so each distinct key is derived at most once and
+# every repeat of that key reuses the cached score. A batch with only a few
+# unique keys now costs that many computations instead of one per event.
+@lru_cache(maxsize=None)
+def _cached_score(profile_key: str) -> int:
+    return score_profile(profile_key)
+
